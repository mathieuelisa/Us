# Copy this file to .env and fill in your Supabase project values
# (Project Settings > API on supabase.com). Never commit the real .env file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key

# Stripe — clé publiable (pk_test_… en développement, pk_live_… en
# production) : active l'achat du premium dans l'app. La clé secrète ne va
# jamais ici : c'est un secret Supabase (`npx supabase secrets set
# STRIPE_SECRET_KEY=…`), comme STRIPE_WEBHOOK_SECRET.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
